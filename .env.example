# Copy these into Vercel → Project → Settings → Environment Variables (never into a file you commit).
NEXT_PUBLIC_SITE_URL=https://givetolight.com
NEXT_PUBLIC_SITE_NAME=Give to Light
# Your email (and other staff, comma-separated). They become admins the first time they log in.
ADMIN_EMAILS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Chariot (DAFpay): the Connect ID from your Chariot dashboard, and the API key + webhook secret
NEXT_PUBLIC_CHARIOT_CID=
CHARIOT_API_KEY=
# Only while testing: the sandbox API address Chariot gives you. Leave empty for live.
CHARIOT_API_URL=
# Organization details shown on receipts
NEXT_PUBLIC_ORG_NAME=The Lighthouse Project
NEXT_PUBLIC_ORG_EIN=84-3301528
